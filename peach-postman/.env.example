# ============================================================
# REQUIRED — tests will not start without these
# ============================================================
API_BASE=https://api.peachpayments.com
API_TOKEN=your-bearer-token-here

# ============================================================
# OPTIONAL — enables additional tests when set
# ============================================================
# ENTITY_ID=your-entity-id
# MERCHANT_ID=your-merchant-id
# EXISTING_PAYMENT_ID=         # Pre-existing payment link ID for opt-in tests
# EXISTING_BATCH_ID=           # Pre-existing batch ID for opt-in tests
# EXISTING_TRANSACTION_ID=     # Pre-existing transaction ID for opt-in tests
# EXISTING_PAYOUT_ID=          # Pre-existing payout request ID for opt-in tests
# EXISTING_BANV_ID=            # Pre-existing bank verification ID for opt-in tests

# ============================================================
# AUTH — OAuth2 client credentials (for /api/oauth/token tests)
# ============================================================
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_MERCHANT_ID=your-merchant-id

# ============================================================
# CHECKOUT — Peach Payments direct auth parameters
# ============================================================
# CHECKOUT_ENTITY_ID=your-entity-id
# CHECKOUT_SIGNATURE=your-hmac-signature

# ============================================================
# ADVANCED — CI / infrastructure triggers
# ============================================================
# CI=true                      # Enable retries and stricter worker limits
