{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "id",
    "paymentType",
    "paymentBrand",
    "amount",
    "currency",
    "descriptor",
    "merchantTransactionId",
    "timestamp",
    "ndc"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "paymentType": {
      "type": "string"
    },
    "paymentBrand": {
      "type": "string"
    },
    "amount": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "descriptor": {
      "type": "string"
    },
    "merchantTransactionId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "ndc": {
      "type": "string"
    }
  }
}
