{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "paymentMethods",
    "brands"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paymentMethods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
