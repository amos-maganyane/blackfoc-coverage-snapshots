{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "scope"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 1
    },
    "token_type": {
      "type": "string",
      "minLength": 1
    },
    "expires_in": {
      "type": "number"
    },
    "scope": {
      "type": "string"
    }
  }
}
