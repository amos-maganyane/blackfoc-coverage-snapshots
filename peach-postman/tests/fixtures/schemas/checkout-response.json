{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "id",
    "ndc"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "parameterErrors"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameterErrors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value",
              "message"
            ]
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ndc": {
      "type": "string"
    }
  }
}
