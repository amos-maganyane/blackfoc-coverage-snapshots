{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "access_token"
  ],
  "additionalProperties": false,
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 1
    },
    "token_type": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  }
}