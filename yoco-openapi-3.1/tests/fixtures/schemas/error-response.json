{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "description": "RFC 7807 problem details response",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "code": {
      "type": "string",
      "enum": [
        "forbidden",
        "method_not_allowed",
        "missing_required_field",
        "not_found",
        "rate_limited",
        "server",
        "unauthorized",
        "validation"
      ]
    },
    "errors": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "detail": { "type": "string" },
          "pointer": { "type": ["string", "null"] },
          "parameter": { "type": ["string", "null"] },
          "code": { "type": "string" }
        },
        "required": ["detail", "code"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "title", "detail", "status", "code"],
  "additionalProperties": false
}
