# ============================================================
# REQUIRED — tests will not start without these
# ============================================================
API_BASE=https://api.yoco.com
API_TOKEN=your-bearer-token-here

# ============================================================
# OPTIONAL — enables additional test scenarios
# ============================================================
# API_TOKEN_READ_ONLY=         # Restricted-scope token for 403 forbidden tests
# API_TRIGGER_RATE_LIMIT=true   # Enables 429 rate-limit tests (requires throttleable environment)

# ============================================================
# ADVANCED — CI / infrastructure triggers
# ============================================================
# CI=true                     # Enable retries and stricter worker limits
