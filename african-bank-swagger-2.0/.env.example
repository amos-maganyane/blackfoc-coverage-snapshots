# ============================================================
# REQUIRED — tests will not start without these
# ============================================================
API_BASE=https://api.grindrodbank.co.za/api
API_TOKEN=your-bearer-token-here

# ============================================================
# OPTIONAL — enables additional tests when set
# ============================================================
# AGENT_ID=your-agent-id           # Required Agent-Id header value; defaults to test-agent-id
# API_TOKEN_READ_ONLY=              # Scoped read-only token for 403 forbidden tests (@extended)

# ============================================================
# ADVANCED — CI / infrastructure triggers
# ============================================================
# CI=true                          # Enable retries and stricter worker limits
