# ============================================================
# REQUIRED — tests will not start without these
# ============================================================
API_BASE=https://api.yoco.com
API_TOKEN=your-bearer-token-here

# ============================================================
# Checkout API base (separate domain)
# ============================================================
CHECKOUT_API_BASE=https://payments.yoco.com
IAM_API_BASE=https://iam.yoco.com

# ============================================================
# OPTIONAL — enables additional @extended tests when set
# ============================================================
# EXISTING_CHECKOUT_ID=ch_abc123
# EXISTING_PAYMENT_ID=pay_abc123
# EXISTING_PAYOUT_ID=pyt_abc123
# EXISTING_REFUND_ID=ref_abc123
# EXISTING_SUBSCRIPTION_ID=sub_abc123
# EXISTING_WEBPOS_DEVICE_ID=wpd_abc123
# EXISTING_ORDER_ID=ord_abc123
# EXISTING_PAYMENT_LINK_ID=pml_abc123

# ============================================================
# ADVANCED — CI / infrastructure triggers
# ============================================================
# CI=true
