{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["sub"],
  "additionalProperties": false,
  "properties": {
    "sub": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "email": { "type": "string" },
    "email_verified": { "type": "boolean" },
    "picture": { "type": "string" },
    "given_name": { "type": "string" },
    "family_name": { "type": "string" }
  }
}
