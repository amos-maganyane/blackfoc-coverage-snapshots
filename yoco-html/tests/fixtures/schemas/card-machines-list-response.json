{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "serialNumber": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string" },
          "locationId": { "type": "string" }
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number" },
        "page": { "type": "number" },
        "pageSize": { "type": "number" }
      }
    }
  }
}
