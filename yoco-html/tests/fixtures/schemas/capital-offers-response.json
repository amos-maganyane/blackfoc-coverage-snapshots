{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "fee": { "type": "number" },
          "repaymentPercentage": { "type": "number" },
          "expiresAt": { "type": "string" }
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number" },
        "page": { "type": "number" },
        "pageSize": { "type": "number" }
      }
    }
  }
}
