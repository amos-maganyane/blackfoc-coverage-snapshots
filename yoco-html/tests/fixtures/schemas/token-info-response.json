{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["active", "clientId"],
  "additionalProperties": false,
  "properties": {
    "active": { "type": "boolean" },
    "clientId": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "sub": { "type": "string" },
    "exp": { "type": "number" },
    "iat": { "type": "number" }
  }
}
